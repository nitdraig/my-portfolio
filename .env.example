# Mailprex (owner notification)
EMAIL_DESTINY=your-inbox@example.com
MAILPREX_FORM_TOKEN=your-mailprex-form-token

# SMTP (thank-you email to submitter)
# Quote values that contain spaces (Gmail app passwords).
MAILER_FROM="Agustín Avellaneda <me@agustin.top>"
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_USER=your-smtp-user
MAILER_PASS="your smtp app password"

# Upstash Redis (contact rate limiting — recommended in production)
# Leave blank locally. Placeholders like "your-instance" are ignored.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
