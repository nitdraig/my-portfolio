---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";
import type { projects as projectsData } from "../../data/projects";

type Project = (typeof projectsData)[number];

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const t = ui[locale].projectDetail;

function statusLabel(status: string | undefined): string {
  if (status === "active") return t.statusActive;
  if (status === "archived") return t.statusArchived;
  return t.statusDevelopment;
}
---

<section class={`py-24 px-4 bg-gradient-to-r ${project.color}`}>
  <div class="max-w-6xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="text-white reveal">
        <span class="inline-flex items-center rounded-full bg-white/20 text-white backdrop-blur-sm px-3 py-1 text-sm font-medium mb-4">
          {project.featured ? t.featured : t.project}
        </span>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">{project.title[locale]}</h1>
        <h2 class="text-xl font-medium opacity-80 mb-6">{project.shortDescription[locale]}</h2>
        <p class="text-lg opacity-90 leading-relaxed mb-8">{project.description[locale]}</p>

        <div class="flex flex-wrap gap-6 mb-8">
          {
            project.year && (
              <div class="text-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/80 mx-auto mb-2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <div class="text-sm font-semibold">{project.year}</div>
                <div class="text-xs text-white/70">{t.year}</div>
              </div>
            )
          }
          <div class="text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/80 mx-auto mb-2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
            <div class="text-sm font-semibold">{statusLabel(project.status)}</div>
            <div class="text-xs text-white/70">{t.status}</div>
          </div>
        </div>

        <div class="flex flex-wrap gap-4">
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-md bg-white text-gray-900 hover:bg-gray-100 px-6 py-3 font-semibold transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
            {t.viewDemo}
          </a>
          {
            project.githubUrl ? (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-md border border-white text-white hover:bg-white/10 px-6 py-3 font-semibold bg-transparent transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                {t.sourceCode}
              </a>
            ) : (
              <span class="inline-flex items-center justify-center rounded-md border border-white/50 text-white/60 px-6 py-3 font-semibold cursor-not-allowed">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                {t.sourceUnavailable}
              </span>
            )
          }
        </div>
      </div>

      <div class="reveal relative">
        <div class="relative rounded-lg overflow-hidden">
          <img
            src={project.image}
            alt={project.title[locale]}
            class="w-full h-full object-cover"
            width="900"
            height="800"
          />
        </div>
      </div>
    </div>
  </div>
</section>
