---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].about;
---

<section id="about" class="border-t border-line bg-ink px-5 py-16 md:px-8 md:py-20">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-12 max-w-2xl">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-paper md:text-4xl">
        {t.title}
      </h2>
      <p class="mt-4 text-lg text-fog">{t.subtitle}</p>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      <article class="reveal border-t border-line pt-6">
        <h3 class="font-display text-xl font-semibold text-paper">
          {t.fullstack.title}
        </h3>
        <p class="mt-3 text-base leading-relaxed text-fog">
          {t.fullstack.description}
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            t.fullstack.tags.map((tech) => (
              <li class="rounded-md border border-line px-2.5 py-0.5 text-sm text-mist">
                {tech}
              </li>
            ))
          }
        </ul>
      </article>

      <article class="reveal border-t border-line pt-6">
        <h3 class="font-display text-xl font-semibold text-paper">
          {t.pm.title}
        </h3>
        <p class="mt-3 text-base leading-relaxed text-fog">
          {t.pm.description}
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            t.pm.tags.map((skill) => (
              <li class="rounded-md border border-line px-2.5 py-0.5 text-sm text-mist">
                {skill}
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</section>
