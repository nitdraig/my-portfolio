---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";
import { buildKnowledgeGraph } from "../../data/knowledgeGraph";
import { getEnrichedProjects } from "../../data/knowledgeGraph";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].system;
const graph = buildKnowledgeGraph(locale);
const projects = getEnrichedProjects();
const prefix = `/${locale}`;

const groupNodes = graph.nodes.filter((n) => n.kind === "group");
const projectNodes = graph.nodes.filter((n) => n.kind === "project");

function polar(i: number, total: number, cx: number, cy: number, r: number) {
  const a = (i / Math.max(total, 1)) * Math.PI * 2 - Math.PI / 2;
  return { x: cx + Math.cos(a) * r, y: cy + Math.sin(a) * r };
}

const cx = 50;
const cy = 48;
const groupPos = new Map(
  groupNodes.map((n, i) => [n.id, polar(i, groupNodes.length, cx, cy, 22)]),
);

const projectPos = new Map(
  projectNodes.map((n, i) => {
    const g = groupPos.get(`group-${n.group}`) ?? { x: cx, y: cy };
    const jitter = polar(i, projectNodes.length, g.x, g.y, 8 + (i % 3) * 2);
    return [n.id, jitter];
  }),
);

const vizEdges = graph.edges.filter(
  (e) =>
    (e.from.startsWith("group-") && e.to.startsWith("project-")) ||
    (e.from.startsWith("root-") && e.to.startsWith("group-")),
);
---

<section class="narrative" id="proof" data-section="proof">
  <div class="sect-head">
    <span class="sect-num">{t.sectionProof}</span>
    <h2 class="sect-title">{t.proofTitle}</h2>
  </div>
  <p class="sect-sub">{t.proofSubtitle}</p>

  <div class="graph-wrap" data-universe aria-hidden="true">
    <svg class="h-[380px] w-full" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
      <circle cx={cx} cy={cy} r="1.4" fill="var(--accent)" />
      <text
        x={cx}
        y={cy - 3}
        text-anchor="middle"
        fill="var(--text)"
        font-size="2.4"
        font-family="Syne,sans-serif"
        font-weight="600">AI</text
      >
      {
        vizEdges.map((edge) => {
          const a =
            edge.from === "root-ai" || edge.from.startsWith("root-")
              ? { x: cx, y: cy }
              : groupPos.get(edge.from) || projectPos.get(edge.from);
          const b = projectPos.get(edge.to) || groupPos.get(edge.to);
          if (!a || !b) return null;
          return (
            <line
              x1={a.x}
              y1={a.y}
              x2={b.x}
              y2={b.y}
              stroke="var(--line)"
              stroke-width="0.25"
            />
          );
        })
      }
      {
        groupNodes.map((n) => {
          const p = groupPos.get(n.id);
          if (!p) return null;
          return (
            <g>
              <circle cx={p.x} cy={p.y} r="1.2" fill="var(--bg-panel)" stroke="var(--text-faint)" stroke-width="0.3" />
              <text
                x={p.x}
                y={p.y - 2.4}
                text-anchor="middle"
                fill="var(--text-dim)"
                font-size="2"
                font-family="IBM Plex Mono,monospace"
              >
                {n.label.toUpperCase()}
              </text>
            </g>
          );
        })
      }
      {
        projectNodes.map((n) => {
          const p = projectPos.get(n.id);
          if (!p || !n.href) return null;
          return (
            <a href={n.href}>
              <circle cx={p.x} cy={p.y} r="0.85" fill="var(--accent)" class="cursor-pointer">
                <title>{n.label}</title>
              </circle>
              <text
                x={p.x}
                y={p.y + 2.8}
                text-anchor="middle"
                fill="var(--text-dim)"
                font-size="1.6"
                font-family="DM Sans,sans-serif"
              >
                {n.label.length > 12 ? `${n.label.slice(0, 11)}…` : n.label}
              </text>
            </a>
          );
        })
      }
    </svg>
  </div>

  <ul class="mt-8 space-y-1 sr-only">
    {
      projects.map((p) => (
        <li>
          <a
            href={`${prefix}/work/${p.slug}`}
            class="flex justify-between gap-4 border-b border-[var(--line)] py-3 text-sm text-[var(--text-dim)] hover:text-[var(--text)] focus-ring"
          >
            <span>{p.title[locale]}</span>
            <span class="font-mono text-[11px] uppercase text-[var(--text-faint)]">{p.graphGroup}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
