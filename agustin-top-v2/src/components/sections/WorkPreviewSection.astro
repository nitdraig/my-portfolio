---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";
import { projects } from "../../data/projects";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].projects;
const prefix = `/${locale}`;

const featured = [...projects]
  .filter((p) => p.featured)
  .sort((a, b) => (a.homeOrder ?? 50) - (b.homeOrder ?? 50))
  .slice(0, 4);
---

<section
  id="work"
  class="border-t border-line bg-ink px-5 py-20 md:px-8 md:py-28"
  aria-labelledby="work-heading"
>
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-12 flex flex-col gap-4 md:mb-16 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <h2
          id="work-heading"
          class="font-display text-3xl font-semibold tracking-tight text-paper md:text-4xl"
        >
          {t.title}
        </h2>
        <p class="mt-4 text-lg text-fog">{t.subtitle}</p>
      </div>
      <a
        href={`${prefix}/work`}
        class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-accent hover:text-accent-dim focus-ring rounded-sm"
      >
        {t.viewAll}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <ul class="reveal grid gap-8 sm:grid-cols-2">
      {
        featured.map((project) => (
          <li>
            <article class="group">
              <a
                href={`${prefix}/work/${project.slug}`}
                class="block focus-ring rounded-md"
              >
                <div class="aspect-[16/10] overflow-hidden rounded-md border border-line bg-ink-soft">
                  <img
                    src={project.image}
                    alt=""
                    width="800"
                    height="500"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </div>
                <div class="mt-5">
                  <h3 class="font-display text-xl font-semibold text-paper group-hover:text-accent transition-colors">
                    {project.title[locale]}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-fog line-clamp-2">
                    {project.shortDescription[locale]}
                  </p>
                  <p class="mt-3 text-xs text-mist/60">
                    {project.year}
                    {" · "}
                    {project.tags.slice(0, 3).join(" · ")}
                  </p>
                </div>
              </a>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
