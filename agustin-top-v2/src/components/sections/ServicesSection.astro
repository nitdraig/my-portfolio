---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].services;
---

<section id="services" class="border-t border-line bg-ink-elevated px-5 py-16 md:px-8 md:py-20">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-12 max-w-2xl">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-paper md:text-4xl">
        {t.title}
      </h2>
      <p class="mt-4 text-lg text-fog">{t.subtitle}</p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {
        t.items.map((service, index) => (
          <article class="reveal border-t border-line pt-6">
            <p class="font-display text-xs text-accent">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="font-display mt-3 text-xl font-semibold text-paper">
              {service.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-fog">
              {service.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
