---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";
import { person } from "../../data/person";
import SceneCanvas from "../scene/SceneCanvas.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].hero;
const prefix = `/${locale}`;
---

<section
  class="relative flex min-h-[100dvh] items-center justify-center overflow-hidden"
  aria-labelledby="hero-heading"
>
  <div class="hero-atmosphere" aria-hidden="true">
    <SceneCanvas mode="chaos" variant="hero" />
    <div class="noise-overlay"></div>
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ink/40 via-ink/55 to-ink"
    >
    </div>
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-4xl px-5 pb-24 pt-28 text-center md:px-8 md:pt-32"
    data-reveal-stagger
  >
    <p
      class="hero-enter mb-6 font-display text-sm font-medium tracking-[0.2em] text-accent uppercase"
      style="--enter-delay: 0ms"
    >
      {person.shortName}
    </p>

    <h1
      id="hero-heading"
      class="hero-enter font-display text-4xl leading-[1.08] font-semibold tracking-tight text-paper sm:text-5xl md:text-7xl"
      style="--enter-delay: 80ms"
    >
      <span class="hero-line">{t.line1}</span>
      <br />
      <span class="hero-line hero-line-delay">{t.line2}</span>
    </h1>

    <p
      class="hero-enter mx-auto mt-6 max-w-xl text-base leading-relaxed text-fog md:text-lg"
      style="--enter-delay: 180ms"
    >
      {t.support}
    </p>

    <div
      class="hero-enter mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
      style="--enter-delay: 280ms"
    >
      <a
        href={`${prefix}/idea`}
        class="btn-motion inline-flex min-h-12 w-full items-center justify-center rounded-md bg-accent px-8 py-3 text-base font-semibold text-ink focus-ring sm:w-auto"
      >
        {t.cta}
      </a>
      <a
        href={`${prefix}/work`}
        class="btn-motion-ghost inline-flex min-h-12 w-full items-center justify-center rounded-md border border-line-strong px-8 py-3 text-base font-medium text-paper focus-ring sm:w-auto"
      >
        {t.ctaSecondary}
      </a>
    </div>
  </div>

  <div
    class="hero-enter absolute bottom-8 left-1/2 z-10 -translate-x-1/2"
    style="--enter-delay: 420ms"
    aria-hidden="true"
  >
    <div
      class="flex h-10 w-6 justify-center rounded-full border border-line-strong"
    >
      <div
        class="mt-2 h-2 w-1 rounded-full bg-mist/60 motion-safe:animate-pulse-soft"
      >
      </div>
    </div>
  </div>
</section>
