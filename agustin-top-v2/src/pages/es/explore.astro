---
export const prerender = true;
const target = "/es/#proof";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href="https://www.agustin.top/es/" />
    <title>Redirecting…</title>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <p><a href={target}>Continue to projects</a></p>
  </body>
</html>
