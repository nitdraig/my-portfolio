---
export const prerender = true;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import ProjectHero from "../../../components/project/ProjectHero.astro";
import ProjectDetails from "../../../components/project/ProjectDetails.astro";
import RelatedProjects from "../../../components/project/RelatedProjects.astro";
import { projects } from "../../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const locale = "en";
const { project } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={`${project.title[locale]} | Agustín Avellaneda`}
  description={project.shortDescription[locale]}
  image={`https://www.agustin.top${project.image}`}
  canonicalPath={`projects/${project.slug}`}
>
  <Navbar locale={locale} />
  <main>
    <ProjectHero locale={locale} project={project} />
    <ProjectDetails locale={locale} project={project} />
    <RelatedProjects locale={locale} project={project} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
