---
import type { Locale } from "../i18n/ui";
import { ui } from "../i18n/ui";
import { switchLocalePath } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const prefix = `/${locale}`;
const esPath = switchLocalePath(Astro.url, "es");
const enPath = switchLocalePath(Astro.url, "en");

const links = [
  { href: `${prefix}/#about`, label: t.nav.me },
  { href: `${prefix}/#projects`, label: t.nav.projects },
  { href: `${prefix}/#blogs`, label: t.nav.blogs },
  { href: `${prefix}/#resources`, label: t.nav.resources },
  { href: `${prefix}/#contact`, label: t.nav.contact },
];
---

<header class="fixed top-0 z-50 w-full bg-gray-900 backdrop-blur supports-[backdrop-filter]:bg-gray-900/60">
  <div class="container text-[#E5E5E5] px-6 md:px-10 flex h-16 items-center justify-between max-w-7xl mx-auto relative">
    <a href={`${prefix}/`} class="flex items-center gap-2 font-bold text-xl z-10">
      <img
        src="/logo-black.png"
        alt="Logo"
        width="80"
        height="40"
        class="h-full w-[5rem] invert hover:translate-y-0.5 transition-transform duration-300 ease-in-out"
      />
    </a>

    <nav class="hidden md:flex gap-6 text-white items-center justify-center flex-1" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-md font-medium hover:text-[#808080] transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    {/* Desktop language switch */}
    <div class="hidden md:flex bg-white/10 backdrop-blur-sm rounded-full p-1">
      <a
        href={enPath}
        class:list={[
          "rounded-full px-4 py-1.5 text-sm font-medium transition-colors",
          locale === "en"
            ? "bg-white text-gray-900"
            : "text-white hover:bg-black hover:text-white",
        ]}
        aria-current={locale === "en" ? "page" : undefined}
      >
        EN
      </a>
      <a
        href={esPath}
        class:list={[
          "rounded-full px-4 py-1.5 text-sm font-medium transition-colors",
          locale === "es"
            ? "bg-white text-gray-900"
            : "text-white hover:bg-black hover:text-white",
        ]}
        aria-current={locale === "es" ? "page" : undefined}
      >
        ES
      </a>
    </div>

    {/* Mobile: hamburger on the right */}
    <div class="md:hidden relative z-10" id="mobile-nav-root">
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-white hover:bg-white/10 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.menuToggle}
      >
        <svg
          id="icon-hamburger"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <svg
          id="icon-close"
          class="hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>

      <div
        id="mobile-menu"
        class="hidden absolute right-0 top-full mt-2 w-56 origin-top-right rounded-lg border border-white/10 bg-gray-900 shadow-xl py-2"
        role="menu"
      >
        <nav class="flex flex-col" aria-label="Mobile">
          {
            links.map((link) => (
              <a
                href={link.href}
                class="mobile-nav-link px-4 py-2.5 text-white hover:bg-white/10 transition-colors"
                role="menuitem"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <div class="mt-2 border-t border-white/10 px-4 pt-3 pb-2">
          <div class="flex bg-white/10 backdrop-blur-sm rounded-full p-1">
            <a
              href={enPath}
              class:list={[
                "flex-1 text-center rounded-full px-4 py-1.5 text-sm font-medium transition-colors",
                locale === "en"
                  ? "bg-white text-gray-900"
                  : "text-white hover:bg-black hover:text-white",
              ]}
              aria-current={locale === "en" ? "page" : undefined}
            >
              EN
            </a>
            <a
              href={esPath}
              class:list={[
                "flex-1 text-center rounded-full px-4 py-1.5 text-sm font-medium transition-colors",
                locale === "es"
                  ? "bg-white text-gray-900"
                  : "text-white hover:bg-black hover:text-white",
              ]}
              aria-current={locale === "es" ? "page" : undefined}
            >
              ES
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const root = document.getElementById("mobile-nav-root");
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-hamburger");
  const iconClose = document.getElementById("icon-close");

  function setOpen(open: boolean) {
    if (!btn || !menu || !iconOpen || !iconClose) return;
    menu.classList.toggle("hidden", !open);
    btn.setAttribute("aria-expanded", open ? "true" : "false");
    iconOpen.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
  }

  function isOpen() {
    return btn?.getAttribute("aria-expanded") === "true";
  }

  btn?.addEventListener("click", (e) => {
    e.stopPropagation();
    setOpen(!isOpen());
  });

  menu?.addEventListener("click", (e) => e.stopPropagation());

  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("click", () => {
    if (isOpen()) setOpen(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) setOpen(false);
  });

  // Astro view transitions / soft nav safety
  document.addEventListener("astro:page-load", () => setOpen(false));
</script>
