---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";
import type { projects as projectsData } from "../../data/projects";

type Project = (typeof projectsData)[number];

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const t = ui[locale].projectDetail;
const results = project.results?.[locale] ?? [];
---

<section class="py-20 px-4 bg-white text-black">
  <div class="max-w-6xl mx-auto reveal">
    <div class="grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-12">
        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">{t.challenge}</h3>
          <p class="text-gray-700 leading-relaxed">
            {project.challenge?.[locale] ?? t.empty.challenge}
          </p>
        </div>

        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">{t.solution}</h3>
          <p class="text-gray-700 leading-relaxed">
            {project.solution?.[locale] ?? t.empty.solution}
          </p>
        </div>

        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-6">{t.results}</h3>
          <div class="grid md:grid-cols-2 gap-4">
            {
              results.length > 0 ? (
                results.map((result) => (
                  <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-lg hover:scale-[1.02] transition-transform">
                    <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    </div>
                    <span class="text-gray-900 font-medium">{result}</span>
                  </div>
                ))
              ) : (
                <p class="text-gray-600">{t.empty.results}</p>
              )
            }
          </div>
        </div>
      </div>

      <div class="space-y-8">
        <div class="border border-gray-200 rounded-lg shadow-sm">
          <div class="p-6">
            <h4 class="text-lg font-semibold text-gray-900 mb-4">{t.technologies}</h4>
            <div class="flex flex-wrap gap-2">
              {
                project.tags?.length ? (
                  project.tags.map((tech) => (
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-sm font-medium text-gray-700">
                      {tech}
                    </span>
                  ))
                ) : (
                  <p class="text-gray-600">{t.empty.tags}</p>
                )
              }
            </div>
          </div>
        </div>

        <div class="border border-gray-200 rounded-lg shadow-sm">
          <div class="p-6 space-y-3">
            <h4 class="text-lg font-semibold text-gray-900 mb-4">{t.links}</h4>
            {
              project.demoUrl && (
                <a
                  href={project.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-start rounded-md bg-gray-900 hover:bg-gray-800 text-white px-4 py-2 text-sm font-medium transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
                  {t.liveDemo}
                </a>
              )
            }
            {
              project.githubUrl ? (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-start rounded-md border border-gray-300 bg-transparent hover:bg-gray-50 px-4 py-2 text-sm font-medium transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                  {t.sourceCode}
                </a>
              ) : (
                <span class="w-full inline-flex items-center justify-start rounded-md border border-gray-300 bg-transparent px-4 py-2 text-sm font-medium text-gray-400 cursor-not-allowed">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                  {t.sourceUnavailable}
                </span>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
