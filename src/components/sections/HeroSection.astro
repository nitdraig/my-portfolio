---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].hero;
const prefix = `/${locale}`;

const socials = [
  {
    label: "GitHub",
    url: "https://github.com/nitdraig",
  },
  {
    label: "LinkedIn",
    url: "https://www.linkedin.com/in/avellaneda-agustin/",
  },
  {
    label: "Email",
    url: "mailto:me@agustin.top",
  },
];

const stats = [t.stats.experience, t.stats.projects, t.stats.satisfaction];
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <div class="absolute inset-0 z-0">
    <div
      class="absolute inset-0 bg-gradient-to-br from-gray-900/90 via-gray-800/80 to-black/90 z-10"
    >
    </div>
    <img
      src="/agustin-hero.webp"
      alt="Developer workspace background"
      class="absolute inset-0 w-full h-full object-cover object-center"
      width="1920"
      height="1080"
      fetchpriority="high"
    />
  </div>

  <div
    class="relative lg:my-24 mt-16 sm:mt-20 z-20 max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-8 lg:gap-12 items-center"
  >
    <div class="text-white">
      <div class="reveal lg:mt-0 pt-4">
        <div class="flex items-start gap-4 mb-4">
          <h1
            class="flex-1 min-w-0 text-3xl sm:text-4xl md:text-6xl font-bold bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent leading-tight"
          >
            {t.name}
          </h1>

          {
            /* Compact profile avatar — mobile / tablet only, right of the name */
          }
          <div class="relative shrink-0 lg:hidden -mt-1">
            <div
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden border-2 border-white/25 shadow-lg"
            >
              <img
                src="/profile.webp"
                alt="Agustin Avellaneda - AI-Powered Developer"
                class="w-full h-full object-cover"
                width="96"
                height="96"
                fetchpriority="high"
              />
            </div>
            <span
              class="absolute -bottom-1 -right-1 inline-flex items-center bg-white text-black border border-white/30 px-1.5 py-0.5 rounded-full text-[10px] font-medium shadow"
            >
              <span
                class="w-1.5 h-1.5 bg-green-600 rounded-full mr-1 animate-pulseDot"
              ></span>
              {t.available}
            </span>
          </div>
        </div>

        <h2 class="text-2xl md:text-3xl font-medium mb-4 text-white/90">
          <em class="italic">{t.roleLead}</em>
          <br class="lg:hidden" />{" "}
          <span>{t.roleRest}</span>
        </h2>
        <p
          class="lg:text-sm text-base text-white/80 mb-4 leading-relaxed max-w-3xl"
        >
          {t.tagline}
        </p>
        <p class="text-sm text-white/80 mb-4 leading-relaxed max-w-3xl">
          {t.founderLine}

          <a
            class="text-white underline"
            href="http://excelso.xyz"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ex<span class="text-red-500">c</span>elso
          </a>
        </p>
      </div>

      <div class="reveal grid grid-cols-3 gap-4 sm:gap-6 mb-4">
        {
          stats.map((stat) => (
            <div class="text-center cursor-pointer hover:scale-105 transition-transform">
              <div class="text-xl sm:text-2xl font-bold text-white mb-1">
                {stat.value}
              </div>
              <div class="text-xs sm:text-sm text-white/70 text-center">
                {stat.label}
              </div>
            </div>
          ))
        }
      </div>

      <div class="reveal flex items-center gap-2 mb-4 text-white/70">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
          ></path><circle cx="12" cy="10" r="3"></circle></svg
        >
        <span>{t.location}</span>
      </div>

      <div class="reveal flex flex-col sm:flex-row gap-4 mb-8">
        <a
          href={`${prefix}/#projects`}
          class="inline-flex items-center justify-center bg-white text-gray-900 hover:bg-gray-100 font-semibold px-8 py-3 rounded-md transition-colors"
        >
          {t.ctaProjects}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="ml-2"
            aria-hidden="true"
            ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </a>
        <a
          href={`${prefix}/#contact`}
          class="inline-flex items-center justify-center border border-white text-white hover:bg-white/80 font-semibold px-8 py-3 rounded-md backdrop-blur-sm bg-transparent transition-colors"
        >
          {t.ctaContact}
        </a>
      </div>

      <div class="reveal flex gap-4">
        {
          socials.map((social) => (
            <a
              href={social.url}
              target={social.url.startsWith("mailto:") ? undefined : "_blank"}
              rel={
                social.url.startsWith("mailto:")
                  ? undefined
                  : "noopener noreferrer"
              }
              aria-label={social.label}
              class="inline-flex h-10 w-10 items-center justify-center rounded-md text-white hover:bg-white/10 backdrop-blur-sm transition-colors"
            >
              {social.label === "GitHub" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                  <path d="M9 18c-4.51 2-5-2-7-2" />
                </svg>
              )}
              {social.label === "LinkedIn" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                  <rect width="4" height="12" x="2" y="9" />
                  <circle cx="4" cy="4" r="2" />
                </svg>
              )}
              {social.label === "Email" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    {/* Full profile composition — desktop only */}
    <div class="reveal hidden lg:flex justify-center lg:justify-end">
      <div class="relative">
        <div class="relative w-80 h-80 md:w-96 md:h-96">
          <div
            class="absolute -top-4 -left-4 w-20 h-20 bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center animate-float"
            style="animation-delay: 0s"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-white"
              aria-hidden="true"
              ><polyline points="16 18 22 12 16 6"></polyline><polyline
                points="8 6 2 12 8 18"></polyline></svg
            >
          </div>
          <div
            class="absolute -top-2 -right-6 w-16 h-16 bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center animate-float"
            style="animation-delay: 0.5s"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-white"
              aria-hidden="true"
              ><path
                d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"
              ></path><path
                d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"
              ></path><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"
              ></path><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"></path><path
                d="M6.003 5.125A3 3 0 0 0 6.401 6.5"></path><path
                d="M3.477 10.896a4 4 0 0 1 .585-.396"></path><path
                d="M19.938 10.5a4 4 0 0 1 .585.396"></path><path
                d="M6 18a4 4 0 0 1-1.967-.516"></path><path
                d="M19.967 17.484A4 4 0 0 1 18 18"></path></svg
            >
          </div>
          <div
            class="absolute -bottom-4 -left-6 w-[4.5rem] h-[4.5rem] bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center animate-float"
            style="animation-delay: 1s"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-white"
              aria-hidden="true"
              ><path
                d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"
              ></path><path
                d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"
              ></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"
              ></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"
              ></path></svg
            >
          </div>
          <div
            class="absolute -bottom-2 -right-4 w-14 h-14 bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center animate-float"
            style="animation-delay: 1.5s"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-white"
              aria-hidden="true"
              ><circle cx="12" cy="8" r="6"></circle><path
                d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg
            >
          </div>

          <div
            class="relative w-full h-full rounded-full overflow-hidden border-4 border-white/20 backdrop-blur-sm shadow-2xl hover:scale-[1.02] transition-transform duration-300"
          >
            <img
              src="/profile.webp"
              alt="Agustin Avellaneda - AI-Powered Developer"
              class="w-full h-full object-cover"
              width="400"
              height="400"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-gray-900/20 to-transparent"
            >
            </div>
          </div>

          <div class="absolute top-8 right-8">
            <span
              class="inline-flex items-center mb-4 bg-white text-black border border-white/30 backdrop-blur-sm px-3 py-1 rounded-full text-sm font-medium"
            >
              <span
                class="w-2 h-2 bg-green-600 rounded-full mr-2 animate-pulseDot"
              ></span>
              {t.available}
            </span>
          </div>

          <div
            class="absolute bottom-8 left-8 bg-white/90 backdrop-blur-sm rounded-lg p-3 shadow-lg"
          >
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-gray-700"
                aria-hidden="true"
                ><path d="M10 2v2"></path><path d="M14 2v2"></path><path
                  d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"
                ></path><path d="M6 2v2"></path></svg
              >
              <span class="text-sm font-semibold text-gray-900"
                >{t.techStack}</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20">
    <div
      class="w-6 h-10 border-2 border-white/30 rounded-full flex justify-center"
    >
      <div class="w-1 h-3 bg-white/60 rounded-full mt-2 animate-scroll-dot">
      </div>
    </div>
  </div>
</section>
