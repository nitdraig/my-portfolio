---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].testimonials;
const items = t.items;

function companyLogoUrl(companyUrl: string): string {
  try {
    const host = new URL(companyUrl).hostname;
    return `https://www.google.com/s2/favicons?domain=${host}&sz=128`;
  } catch {
    return "";
  }
}
---

<section class="py-20 px-4 bg-white" id="testimonials">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16 reveal">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">{t.title}</h2>
    </div>

    <div class="relative px-2 sm:px-0" id="testimonial-carousel">
      <div class="overflow-hidden">
        <div id="testimonial-track" class="flex transition-transform duration-500 ease-in-out items-stretch">
          {
            items.map((testimonial) => {
              const logoUrl = companyLogoUrl(testimonial.companyUrl);
              return (
                <div class="w-full flex-shrink-0 px-2 sm:px-4 flex">
                  <article class="testimonial-card border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-all duration-300 w-full max-w-2xl mx-auto bg-white flex flex-col justify-center">
                    <div class="p-6 flex flex-col justify-center items-center">
                      <div class="flex items-center gap-1 mb-4 justify-center" aria-hidden="true">
                        {[1, 2, 3, 4, 5].map(() => (
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#facc15" stroke="#facc15" stroke-width="2">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                          </svg>
                        ))}
                      </div>
                      <blockquote class="text-gray-600 text-base sm:text-lg text-center leading-relaxed">
                        "{testimonial.text}"
                      </blockquote>
                    </div>
                    <div class="px-6 pb-6">
                      <div class="flex items-center gap-3 justify-center">
                        <div class="relative w-12 h-12 shrink-0">
                          {
                            logoUrl ? (
                              <img
                                src={logoUrl}
                                alt=""
                                width="48"
                                height="48"
                                loading="lazy"
                                class="w-12 h-12 rounded-full object-cover bg-white border border-gray-200 p-1.5"
                                aria-hidden="true"
                              />
                            ) : (
                              <div class="w-12 h-12 bg-gray-900 rounded-full flex items-center justify-center text-white font-bold text-lg">
                                {testimonial.name.charAt(0)}
                              </div>
                            )
                          }
                        </div>
                        <div class="text-center min-w-0">
                          <p class="font-semibold text-gray-900 text-lg">{testimonial.name}</p>
                          <p class="text-sm text-gray-500">
                            {testimonial.role}
                            <a
                              href={testimonial.companyUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-gray-500 hover:text-gray-700 hover:underline"
                            >
                              {testimonial.companyName}
                            </a>
                          </p>
                        </div>
                      </div>
                    </div>
                  </article>
                </div>
              );
            })
          }
        </div>
      </div>

      <button
        type="button"
        id="testimonial-prev"
        class="absolute left-0 top-1/2 -translate-y-1/2 min-h-11 min-w-11 inline-flex items-center justify-center bg-white rounded-full p-2.5 shadow-lg hover:shadow-xl transition-all duration-200 border border-gray-200 hover:bg-gray-50 z-10"
        aria-label={t.prev}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-600" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <button
        type="button"
        id="testimonial-next"
        class="absolute right-0 top-1/2 -translate-y-1/2 min-h-11 min-w-11 inline-flex items-center justify-center bg-white rounded-full p-2.5 shadow-lg hover:shadow-xl transition-all duration-200 border border-gray-200 hover:bg-gray-50 z-10"
        aria-label={t.next}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-600" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>

      <div class="flex flex-col items-center gap-3 mt-8">
        <p
          id="testimonial-counter"
          class="text-sm font-medium text-gray-500 tabular-nums"
          aria-live="polite"
        >
          {t.counter.replace("{current}", "1").replace("{total}", String(items.length))}
        </p>
        <div id="testimonial-dots" class="flex justify-center gap-2">
          {
            items.map((_, index) => (
              <button
                type="button"
                class="testimonial-dot min-h-11 min-w-11 inline-flex items-center justify-center rounded-full transition-all duration-200"
                data-index={index}
                aria-label={`${t.goTo} ${index + 1}`}
              >
                <span class="block w-3 h-3 rounded-full bg-gray-400 hover:bg-gray-500 transition-colors duration-200" aria-hidden="true" />
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ total: items.length, counterTemplate: t.counter }}>
  const track = document.getElementById("testimonial-track");
  const prevBtn = document.getElementById("testimonial-prev");
  const nextBtn = document.getElementById("testimonial-next");
  const counter = document.getElementById("testimonial-counter");
  const dots = document.querySelectorAll(".testimonial-dot");
  const carousel = document.getElementById("testimonial-carousel");

  let currentIndex = 0;
  let autoplayId = null;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function updateSlide(index) {
    currentIndex = ((index % total) + total) % total;
    if (track) track.style.transform = `translateX(-${currentIndex * 100}%)`;
    if (counter) {
      counter.textContent = counterTemplate
        .replace("{current}", String(currentIndex + 1))
        .replace("{total}", String(total));
    }
    dots.forEach((dot, i) => {
      const indicator = dot.querySelector("span");
      if (indicator) {
        indicator.classList.toggle("bg-gray-900", i === currentIndex);
        indicator.classList.toggle("scale-110", i === currentIndex);
        indicator.classList.toggle("bg-gray-400", i !== currentIndex);
      }
    });
  }

  function startAutoplay() {
    if (reducedMotion || autoplayId) return;
    autoplayId = window.setInterval(() => updateSlide(currentIndex + 1), 5000);
  }

  function stopAutoplay() {
    if (autoplayId) {
      clearInterval(autoplayId);
      autoplayId = null;
    }
  }

  function syncCardHeights() {
    const cards = document.querySelectorAll(".testimonial-card");
    if (!cards.length) return;
    cards.forEach((card) => {
      card.style.minHeight = "";
    });
    const maxHeight = Math.max(
      ...Array.from(cards).map((card) => card.getBoundingClientRect().height),
    );
    cards.forEach((card) => {
      card.style.minHeight = `${maxHeight}px`;
    });
  }

  prevBtn?.addEventListener("click", () => updateSlide(currentIndex - 1));
  nextBtn?.addEventListener("click", () => updateSlide(currentIndex + 1));
  dots.forEach((dot) => {
    dot.addEventListener("click", () => updateSlide(Number(dot.dataset.index)));
  });

  carousel?.addEventListener("mouseenter", stopAutoplay);
  carousel?.addEventListener("mouseleave", startAutoplay);

  updateSlide(0);
  syncCardHeights();
  window.addEventListener("resize", syncCardHeights);
  startAutoplay();
</script>
